{
  "name": "gbrain-tutoring-system",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "gbrain-tutor": "src/cli.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "bun run scripts/lint.ts",
    "build": "bun build src/cli.ts --target=bun --outdir=dist",
    "doctor": "bun src/cli.ts doctor",
    "smoke": "bash scripts/smoke.sh"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
